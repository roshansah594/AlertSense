# AlertSense Unified Backend Configuration
ENVIRONMENT=development

# Google Gemini AI Configuration (Leave placeholder or blank to use deterministic offline fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Authentication & RBAC Configuration
ADMIN_API_KEY=alertsense-admin-dev-key
USER_API_KEY=alertsense-user-dev-key

# CORS Allowed Origins (Comma-separated list of allowed origins)
# In development, defaults to http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite Database Persistence Path (Optional override)
ALERT_SENSE_DB_PATH=alertsense.db
